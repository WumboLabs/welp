{
  "schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WELP campaign toolchain preflight result",
  "version": "0.1.0-draft",
  "type": "object",
  "required": [
    "preflight",
    "version",
    "generated_utc",
    "hardware",
    "toolchain",
    "protocol",
    "publication",
    "safety",
    "output",
    "overall"
  ],
  "properties": {
    "preflight": {
      "const": "welp-preflight"
    },
    "version": {
      "type": "string"
    },
    "generated_utc": {
      "type": "string"
    },
    "overall": {
      "enum": [
        "GO",
        "NO_GO"
      ]
    },
    "hardware": {
      "type": "object"
    },
    "toolchain": {
      "type": "object",
      "required": [
        "selected_runtime",
        "localmaxxing"
      ]
    },
    "protocol": {
      "type": "object",
      "required": [
        "snapshot_id",
        "welp_status"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^welp-next-snapshot-"
        },
        "welp_status": {
          "const": "DRAFT"
        }
      }
    },
    "publication": {
      "type": "object",
      "required": [
        "localmaxxing_auth_status"
      ],
      "properties": {
        "localmaxxing_auth_status": {
          "enum": [
            "READY",
            "AUTH_BLOCKED",
            "CLI_INCOMPATIBLE",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "safety": {
      "type": "object"
    },
    "output": {
      "type": "object",
      "required": [
        "campaign_workspace_abs",
        "evidence_path_writable"
      ]
    }
  }
}
