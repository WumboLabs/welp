        "gate_baseline_reasoning_state": {"enum": ["REASONING_OFF", "ON", "NOT_APPLICABLE"],
          "description": "Explicit gate reasoning state; required before any Phase-3 generation."},
        "reasoning_requested": {"type": "string"},
        "reasoning_effective": {"type": "string"}}},
    "delta": {"type": "array", "items": {"type": "object",
      "properties": {"field": {"type": "string"}, "requested": {}, "effective": {}}}}}
