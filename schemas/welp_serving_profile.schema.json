    "migration_type": "naming-only"
  },
  "type": "object",
  "required": ["model", "runtime", "placement", "requested", "effective"],
  "properties": {
    "model": {"type": "object", "required": ["repo", "revision", "file", "sha256"],
      "properties": {"repo": {"type": "string"}, "revision": {"type": "string"},
        "file": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "runtime": {"type": "object", "required": ["name", "build", "commit"],
      "properties": {"name": {"type": "string"}, "build": {"type": "integer"}, "commit": {"type": "string"}}},
    "placement": {"type": "object", "required": ["gpu_layers", "cpu_offload"],
      "properties": {"gpu_layers": {}, "cpu_offload": {"type": "boolean"}}},
    "requested": {"type": "object",
      "required": ["parallel", "fit", "flash_attn", "context_total", "batch", "ubatch",
        "template", "reasoning_mode", "sampling", "speculation"],
      "properties": {
        "parallel": {"type": "integer", "minimum": 1},
        "fit": {"enum": ["on", "off"]},
        "flash_attn": {"enum": ["on", "off"]},
        "context_total": {"type": "integer"},
        "batch": {"type": "integer"}, "ubatch": {"type": "integer"},
        "template": {"type": "string"},
        "reasoning_mode": {"type": "string"},
        "sampling": {"type": "object"},
        "speculation": {"type": "string"}}},
    "effective": {"type": "object",
      "required": ["slot_count", "per_slot_context", "kv_placement", "evidence"],
      "properties": {
        "slot_count": {"type": "integer", "minimum": 1},
        "per_slot_context": {"type": "integer"},
        "total_context": {"type": "integer"},
        "kv_placement": {"type": "string"},
        "recurrent_state_placement": {"type": ["string", "null"]},
        "endpoint_alias": {"type": "string"},
        "server_concurrency": {"type": "integer"},
        "evidence": {"type": "array", "items": {"type": "string"},
