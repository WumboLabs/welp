{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WELP serving profile identity (requested vs effective)",
  "version": "0.1.0-draft",
  "supersedes": {
    "schema": "wlep_serving_profile.schema.json",
