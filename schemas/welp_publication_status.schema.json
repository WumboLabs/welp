{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WELP publication status",
  "version": "0.1.0-draft",
  "type": "object",
  "required": [
    "github",
    "localmaxxing",
    "wumbocore",
    "x"
  ],
  "properties": {
    "github": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "localmaxxing": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "submissions": {
          "type": "array"
        },
        "superseded_local_ids": {
          "type": "array"
        },
        "disposition": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "SUBMITTED",
                "MEASURED_NOT_SUBMITTED",
                "NOT_ELIGIBLE",
                "BLOCKED"
              ]
            },
            "origin": {
              "enum": [
                "NEW",
                "VERIFIED_EXISTING",
                "none"
              ]
            },
            "submission_ref": {
              "type": "string"
            },
            "actual_prompt_tokens": {
              "type": "integer"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "report_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "wumbocore": {
      "type": "object",
      "required": [
        "status"
      ]
    },
    "x": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_AUTHORIZED",
            "AUTHORIZED_PENDING_POSTING",
            "POSTED"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
