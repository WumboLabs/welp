{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WELP pre-scoring setup (preregistration)",
  "version": "0.1.0-draft",
  "type": "object",
  "required": [
    "setup",
    "version",
    "frozen_before_scoring",
    "frozen_utc",
    "profile",
    "lanes",
    "lane_coverage",
    "task_classes",
    "ceiling_selection",
    "operational_caps",
    "cache_controls",
    "seed_plan"
  ],
  "properties": {
    "setup": {
      "const": "welp-setup"
    },
    "version": {
      "const": "0.1.0-draft"
    },
    "frozen_before_scoring": {
      "const": true
    },
    "frozen_utc": {
      "type": "string"
    },
    "winning_lane_selected_after_outputs": {
      "const": false
    },
    "profile": {
      "type": "object",
      "required": [
        "selected_profile",
        "profile_id",
        "template_name",
        "template_sha256",
        "sampler",
        "effective_reasoning"
      ],
      "properties": {
        "selected_profile": {
          "const": "DEPLOYMENT"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "template_name": {
          "type": "string",
          "minLength": 1
        },
        "template_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sampler": {
          "type": "object"
        },
        "requested_reasoning": {
          "type": "object"
        },
        "effective_reasoning": {
          "type": "object"
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lane_id",
          "applicable"
        ],
        "properties": {
          "lane_id": {
            "enum": [
              "MINIMAL",
              "DEPLOYMENT",
              "PUBLISHER",
              "OPTIMIZED"
            ]
          },
          "applicable": {
            "type": "boolean"
          },
          "applicability_reason": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          },
          "budget_lane": {
            "type": "string"
          },
          "knowledge_policy": {
            "enum": [
              "open_knowledge",
              "supplied_context"
            ]
          },
          "system_prompt": {
            "type": "string"
          },
          "template_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sampler": {
            "type": "object"
          },
          "requested_reasoning": {
            "type": "object"
          },
          "effective_reasoning": {
            "type": "object"
          },
          "rendered_prompt_file": {
            "type": "string"
          },
          "rendered_prompt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_review": {
            "type": "object",
            "required": [
              "reviewer",
              "answerability_confirmed",
              "contradictions_found",
              "knowledge_policy_matches_rendered",
              "reviewed_rendered_sha256"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "answerability_confirmed": {
                "const": true
              },
              "contradictions_found": {
                "const": false
              },
              "knowledge_policy_matches_rendered": {
                "const": true
              },
              "reviewed_rendered_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "lane_coverage": {
      "type": "object"
    },
    "task_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "class_id",
          "scored_tasks",
          "calibration",
          "representativeness_review"
        ],
        "properties": {
          "class_id": {
            "type": "string",
            "minLength": 1
          },
          "representativeness_review": {
            "type": "object",
            "required": [
              "digest",
              "mode",
              "reviewers",
              "rubric_id",
              "rationale",
              "decision"
            ],
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mode": {
                "enum": [
                  "BLINDED_DUAL_AGREEMENT",
                  "METHOD_REVIEW"
                ]
              },
              "reviewers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "independent_of_execution",
                    "model_identity_blinded",
                    "decision"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "enum": [
                        "human",
                        "agent"
                      ]
                    },
                    "independent_of_execution": {
                      "type": "boolean"
                    },
                    "model_identity_blinded": {
                      "type": "boolean"
                    },
                    "decision": {
                      "enum": [
                        "REPRESENTATIVE",
                        "NOT_REPRESENTATIVE"
                      ]
                    }
                  }
                }
              },
              "rubric_id": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "enum": [
                  "REPRESENTATIVE",
                  "NOT_REPRESENTATIVE"
                ]
              },
              "method_justification": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "scored_tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "task_id",
                "prompt_file",
                "prompt_sha256",
                "answer_budget",
                "evidence_policy",
                "response_class"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "prompt_file": {
                  "type": "string"
                },
                "prompt_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "answer_budget": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "evidence_policy": {
                  "enum": [
                    "open_knowledge",
                    "supplied_context"
                  ]
                },
                "response_class": {
                  "type": "string",
                  "minLength": 1
                },
                "user_turns": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "calibration": {
            "type": "object",
            "required": [
              "lane_id",
              "examples",
              "records_file",
              "records_sha256",
              "per_request_time_limit_s",
              "total_time_limit_s"
            ],
            "properties": {
              "lane_id": {
                "type": "string"
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "example_id",
                    "prompt_file",
                    "prompt_sha256"
                  ],
                  "properties": {
                    "example_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prompt_file": {
                      "type": "string"
                    },
                    "prompt_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              },
              "records_file": {
                "type": "string"
              },
              "records_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "per_request_time_limit_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "total_time_limit_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "status": {
                "not": {
                  "const": "NOT_APPLICABLE"
                }
              }
            }
          }
        }
      }
    },
    "ceiling_selection": {
      "type": "object",
      "required": [
        "ladder",
        "per_class"
      ],
      "properties": {
        "ladder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          }
        },
        "per_class": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "selected_ceiling",
              "blocker"
            ],
            "properties": {
              "selected_ceiling": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "blocker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observed_completion_count": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "operational_caps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lane_id",
          "cap_tokens",
          "slo_rationale"
        ],
        "properties": {
          "lane_id": {
            "type": "string"
          },
          "cap_tokens": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "slo_rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cache_controls": {
      "type": "object",
      "required": [
        "scientific_arms",
        "cached_arms_separate",
        "uncached_probe"
      ],
      "properties": {
        "scientific_arms": {
          "const": "DISABLED_UNCACHED"
        },
        "cached_arms_separate": {
          "const": true
        },
        "cached_arms": {
          "type": "array"
        },
        "uncached_probe": {
          "type": "object",
          "required": [
            "profile_id",
            "lane_id",
            "prompt_file",
            "prompt_sha256",
            "repeated_prompt_count",
            "runtime_cache_check",
            "raw_evidence_file",
            "raw_evidence_sha256"
          ],
          "properties": {
            "profile_id": {
              "type": "string"
            },
            "lane_id": {
              "type": "string"
            },
            "prompt_file": {
              "type": "string"
            },
            "prompt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "repeated_prompt_count": {
              "type": "integer",
              "minimum": 2
            },
            "runtime_cache_check": {
              "type": "object",
              "required": [
                "name",
                "passed"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "passed": {
                  "const": true
                }
              }
            },
            "raw_evidence_file": {
              "type": "string"
            },
            "raw_evidence_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "seed_plan": {
      "type": "object",
      "required": [
        "base_seeds"
      ],
      "properties": {
        "base_seeds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer"
          }
        },
        "adaptive_seed": {
          "type": "integer"
        },
        "adaptive_max_cost_tokens": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "adaptive_max_cost_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
