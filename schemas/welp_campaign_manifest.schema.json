{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WELP campaign manifest",
  "version": "0.1.0-draft",
  "type": "object",
  "required": [
    "campaign_id",
    "protocol_snapshot",
    "model",
    "runtime",
    "serving_profile",
    "publication_status"
  ],
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "protocol_snapshot": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^welp-next-snapshot-[0-9]{4}-[0-9]{2}-[0-9]{2}(-[a-z0-9-]+)?$",
          "description": "Protocol snapshot identity."
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "repo",
        "revision",
        "file",
        "sha256"
      ]
    },
    "source_revision": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "required": [
        "name",
        "build",
        "commit"
      ]
    },
    "hardware_profile": {
      "type": "object"
    },
    "serving_profile": {
      "type": "object",
      "required": [
        "requested",
        "effective"
      ]
    },
    "phase5_applicability": {
      "type": [
        "object",
        "null"
      ]
    },
    "contracts": {
      "type": "object",
      "patternProperties": {
        "^welp-[a-z0-9-]+$": {
          "type": "object"
        }
      }
    },
    "scorers": {
      "type": "object"
    },
    "fixtures": {
      "type": "object"
    },
    "artifact_index": {
      "type": "string"
    },
    "publication_status": {
      "type": "string"
    },
    "reproduction": {
      "type": "string"
    }
  }
}
